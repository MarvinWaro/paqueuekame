{
  "name": "paqueuekame",
  "private": true,
  "version": "0.1.0",
  "description": "Open-play queue for a pickleball team. React + Cloudflare Workers + D1.",
  "type": "module",
  "scripts": {
    "predev": "wrangler d1 migrations apply paqueuekame --local",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply paqueuekame --local",
    "db:fresh:local": "node -e \"try{require('fs').rmSync('.wrangler/state/v3/d1',{recursive:true,force:true})}catch(e){console.error('The local database is in use. Stop npm run dev (Ctrl+C), then run this again.');process.exit(1)}\" && wrangler d1 migrations apply paqueuekame --local",
    "db:migrate:remote": "wrangler d1 migrations apply paqueuekame --remote"
  },
  "dependencies": {
    "driver.js": "1.9.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.0",
    "wrangler": "^4.24.0"
  }
}
